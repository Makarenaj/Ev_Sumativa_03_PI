         <input id="corredora" value="{{ estado.nombre_corredora or 'Sin corredora asignada' }}" disabled>
-        <span class="field-help">Se asigna desde el perfil de tu cuenta.</span>
+        <span class="field-help">{% if usuario_actual.rol == "administrador" %}La corredora de una calificación no se puede cambiar.{% else %}Se asigna desde el perfil de tu cuenta.{% endif %}</span>
+        {% endif %}
       </div>
     </div>
